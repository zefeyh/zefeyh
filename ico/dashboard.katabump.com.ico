<!-- Vendor CSS Files : Bootstrap, Bootstrap-icons, Boxicons, Quill, Remixicon, Simple-Datatables -->
<link href="https://dashboard.katabump.com/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
<link href="https://dashboard.katabump.com/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
<link href="https://dashboard.katabump.com/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
<link href="https://dashboard.katabump.com/assets/vendor/quill/quill.snow.css" rel="stylesheet">
<link href="https://dashboard.katabump.com/assets/vendor/quill/quill.bubble.css" rel="stylesheet">
<link href="https://dashboard.katabump.com/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
<link href="https://dashboard.katabump.com/assets/vendor/simple-datatables/style.css" rel="stylesheet">

<!-- Feuille de style applicative + scripts anti-bot (Turnstile asynchrone, Altcha en module) -->
<link href="https://dashboard.katabump.com/assets/css/style.css" rel="stylesheet">
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script async defer src="https://dashboard.katabump.com/assets/js/altcha.min.js" type="module"></script>

  <style>
    .position-relative {
      position: relative;
    }

    .forgot-password {
      position: absolute;
      right: 10px;
      top: 20%;
      transform: translateY(-50%);
      font-size: 0.875rem;
      text-decoration: none;
    }
  </style>
</head>

<body>

  <main>
    <div class="container">

      <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">

              <div class="d-flex justify-content-center py-4">
                <a href="index.html" class="logo d-flex align-items-center w-auto">
                  <img src="https://cdn.katabump.fr/images/favicon.png" alt="">
                  <span class="d-none d-lg-block">KataBump</span>
                </a>
              </div><!-- End Logo -->

              <div class="card mb-3">

                <div class="card-body">

                  <div class="pt-4 pb-2">
                    <h5 class="card-title text-center pb-0 fs-4">Login to your account</h5>
                    <p class="text-center small">Enter your email & password to login</p>
                  </div>

                  <!-- Affichage des alertes selon le paramètre ?error / ?forgot -->
                                    

                  <!-- Formulaire de connexion email/mot de passe -->
                  <form class="row g-3 needs-validation" novalidate id="login-form" action="" method="POST">

                    <div class="col-12">
                      <label for="email" class="form-label">Email</label>
                      <div class="input-group has-validation">
                        <span class="input-group-text" id="inputGroupPrepend">@</span>
                        <input type="email" name="email" class="form-control" id="email" required>
                        <div class="invalid-feedback">Please enter your email.</div>
                      </div>
                    </div>

                    <div class="col-12 position-relative">
                      <label for="password" class="form-label">Password</label>
                      <input type="password" name="password" class="form-control" id="password" required>
                      <a href="/auth/forgot" class="forgot-password">Forgot ?</a>
                      <div class="invalid-feedback">Please enter your password.</div>
                    </div>

                    <!-- Captcha Turnstile affiché seulement s'il est configuré -->
                                           <div class="col-12">
                           <div class="cf-turnstile" data-sitekey="0x4AAAAAAA1IssKDXD0TRMjP" data-size="flexible"></div>
                       </div>
                    
                    <div class="col-12">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="remember" value="true" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                      </div>
                    </div>
                    <div class="col-12">
                      <button class="btn btn-primary w-100" id="submit" type="submit">Login</button>
                    </div>
                    <div class="col-12">
                      <p class="small mb-0">Don't have account? <a href="/auth/register">Create an account</a></p>
                    </div>
                  </form>
                  <hr>
                  <!-- Connexion via Discord (OAuth) -->
                  <div class="col-12">
                    <button class="btn btn-light w-100" type="button" id="discord"><i class="bi bi-discord"></i> Login
                      with Discord</button>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

      </section>

    </div>
  </main><!-- End #main -->

  <!-- État du bouton submit pendant la soumission -->
  <script>
    document.getElementById('login-form').addEventListener('submit', function (event) {
      if (!this.checkValidity()) {
        return;
      }

      const submitButton = document.getElementById('submit');
      submitButton.disabled = true;
      submitButton.innerHTML = `
      <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
      </div>`;
    });
  </script>


  <!-- Gestion du parrainage via hash d'URL + bouton Discord -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function getHashValue() {
        return window.location.hash.substring(1);
      }

      function createCookie(name, value, days) {
        let expires = "";
        if (days) {
          const date = new Date();
          date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
          expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + (value || "") + expires + "; path=/";
      }

      const referralValue = getHashValue();

      if (referralValue) {
        createCookie('referral', referralValue, 7); // Le cookie expire après 7 jours
      }

      const DiscordButton = document.getElementById('discord');
      if (DiscordButton) {
        DiscordButton.addEventListener('click', function () {
          window.location.href = '/auth/discord';
        });
      }
    });
  </script>

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i
      class="bi bi-arrow-up-short"></i></a>

  <script src="/assets/vendor/apexcharts/apexcharts.min.js"></script>
  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/vendor/chart.js/chart.umd.js"></script>
  <script src="/assets/vendor/echarts/echarts.min.js"></script>
  <script src="/assets/vendor/quill/quill.js"></script>
  <script src="/assets/vendor/simple-datatables/simple-datatables.js"></script>
  <script src="/assets/vendor/tinymce/tinymce.min.js"></script>
  <script src="/assets/vendor/php-email-form/validate.js"></script>
  <script src="/assets/js/main.js"></script>

